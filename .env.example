# Copy to .env and fill in. .env is gitignored.

# How agent containers authenticate to Claude: "subscription" or "api-key".
CLAUDE_AUTH=subscription
# subscription: a one-year token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# api-key: only used when CLAUDE_AUTH=api-key. Never set both.
ANTHROPIC_API_KEY=

# Jira Cloud: the site URL, your login email, and an API token from
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Bitbucket Cloud token. Either kind works:
# - An API token for your own account, so pushes and pull requests show you as the author.
#   Atlassian account settings > Security > Create API token with scopes > app "Bitbucket",
#   scopes read:repository:bitbucket, write:repository:bitbucket,
#   read:pullrequest:bitbucket, write:pullrequest:bitbucket.
# - A repository access token (Repository settings > Access tokens), which acts as a
#   separate bot, with read/write access to the repository and pull requests.
BITBUCKET_TOKEN=

# Name and email on the worker's commits.
AIDEV_GIT_NAME=aidev
AIDEV_GIT_EMAIL=aidev@localhost
